Dockerfile
.dockerignore
compose.yaml
docker-compose.yml
docker-compose.*

# 文档与日志
README.md
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 类型声明缓存
*.tsbuildinfo
